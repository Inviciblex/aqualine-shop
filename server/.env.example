# Скопируйте в .env (без .example). Этот файл НЕ должен попадать в git.

# Токен бота от @BotFather (живёт только здесь, на сервере)
TG_BOT_TOKEN=

# ID чата, куда приходят заказы
TG_CHAT_ID=

# Кому разрешено слать заказы (CORS). Без слэша в конце. Варианты:
#   *                                   — любой источник (удобно для отладки)
#   https://shop.example.ru             — один домен
#   несколько через запятую: http://localhost:5173, https://shop.example.ru
ALLOWED_ORIGIN=*

# Порт бэкенда
PORT=8787

# ── Доступ в админку (/admin) ──
# Основной способ: аккаунты-администраторы. Перечислите email через запятую —
# покупатель, вошедший в кабинет под таким email, автоматически получает права
# админа (отдельный токен не нужен). Заведите аккаунт на сайте («Кабинет») этим email.
ADMIN_EMAILS=

# Аварийный fallback-вход по заголовку X-Admin-Token (напр. если ещё не завели
# аккаунт-админ). Длинная случайная строка; пусто — fallback выключен. Админка
# считается включённой, если задан ADMIN_EMAILS ИЛИ ADMIN_TOKEN.
ADMIN_TOKEN=

# ── Личный кабинет покупателей (email + пароль) ──
# Секрет подписи сессионных кук. ОБЯЗАТЕЛЬНО задайте в проде длинной случайной
# строкой: иначе секрет выводится из ADMIN_TOKEN, а без него — случайный на
# запуск (после рестарта разлогинит всех). Меняйте только осознанно — смена
# инвалидирует все активные сессии.
SESSION_SECRET=
# Ставить ли флаг Secure на сессионную куку (только HTTPS). В проде за TLS: 1.
COOKIE_SECURE=1

# (необязательно) Путь к файлу базы заказов. По умолчанию orders.db рядом с сервером.
# DB_PATH=/var/www/aqualine/server/orders.db
