{
  "name": "aqualine-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "fetch:images": "node scripts/fetch-images.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"{src,server,test}/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"{src,server,test}/**/*.{js,jsx,css}\"",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=88 --test-coverage-branches=82 --test-coverage-functions=85 test/*.test.js"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "vite": "^8.1.0"
  }
}
