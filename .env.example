# Скопируйте в .env (без .example). После изменения — перезапуск dev / пересборка.

# Адрес бэкенда заказов (папка server/). Токен Telegram сюда НЕ пишется.
#   /api/order                              — если фронт и бэкенд на одном домене
#   https://api.ваш-домен.ру/api/order      — если на разных
VITE_ORDER_API_URL=

# (необязательно) Товары из Google Таблицы вместо public/products.json.
# Адрес опубликованного CSV (см. README, «Товары в Google Таблице»).
# Если пусто — используется public/products.json.
VITE_SHEET_CSV_URL=

# (необязательно) Оптимизация фото на лету через image-proxy: ресайз до
# 1200×900, кроп 4:3 и WebP. Значение = провайдер (сейчас 'weserv'). Пусто —
# фото отдаются как есть. Требует пересборки web (build-time переменная).
VITE_IMG_PROXY=

# (необязательно, только для `npm run fetch:images -- --push`) Автопростановка
# локальных путей фото в колонку images таблицы через Google Sheets API.
# Нужен сервис-аккаунт Google с доступом «Редактор» к таблице (см. README,
# «Фото товаров → автоматизация»). Это НЕ VITE_-переменные: в клиент не попадают.
# Путь к JSON-ключу сервис-аккаунта (файл в .gitignore, в репозиторий не кладём):
GOOGLE_APPLICATION_CREDENTIALS=
# id таблицы из адреса: docs.google.com/spreadsheets/d/<ЭТОТ_ID>/edit
SHEETS_SPREADSHEET_ID=
# Имя вкладки (необязательно; пусто = первая вкладка):
SHEETS_TAB=
