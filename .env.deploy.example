# Скопируйте на сервере в файл .env рядом с docker-compose.prod.yml.
# Это переменные ПОДСТАНОВКИ для compose (не секреты приложения).

# Префикс образов в GHCR. Замените youruser на ваш логин/организацию GitHub
# в НИЖНЕМ регистре.
IMAGE_PREFIX=ghcr.io/youruser

# Какой тег образа разворачивать. latest — последний из main.
TAG=latest
