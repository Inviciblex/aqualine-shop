<?xml version="1.0" encoding="UTF-8"?>
<!--
  Карта сайта. ЗАМЕНИТЕ https://ваш-домен.ру на свой домен перед запуском (домен
  для товарных URL берётся автоматически из первого <loc> ниже).

  Сайт на History-роутинге (настоящие URL /product/3), поэтому каждая страница
  индексируется отдельно. Ниже — главная и информационные страницы (стабильные).

  Товарные <url> (/product/N) дописываются АВТОМАТИЧЕСКИ на сборке из финального
  public/products.json (scripts/sync-catalog.mjs → injectProductUrls). В репозитории
  этот файл — шаблон без товарных URL; они появляются в собранном образе.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
