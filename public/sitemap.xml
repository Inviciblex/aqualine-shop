<?xml version="1.0" encoding="UTF-8"?>
<!--
  Карта сайта. ЗАМЕНИТЕ https://ваш-домен.ру на свой домен перед запуском.

  Сейчас сайт на hash-роутинге (#/product/3) — поисковики не индексируют
  адреса с # как отдельные страницы, поэтому здесь указана только главная.
  Чтобы каждый товар попадал в карту сайта отдельной строкой, нужен
  History-роутинг (настоящие URL /product/3) — см. README, раздел про SEO.
  Тогда сюда добавляются <url> по одному на товар.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://ваш-домен.ру/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
